generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["invoice"]
}

enum InvoiceStatus {
  draft
  submitted
  voided

  @@schema("invoice")
}

model IssuerProfile {
  id             String   @id @default(cuid())
  legalName      String   @map("legal_name")
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String   @default("ET")
  email          String?
  phone          String?
  taxId          String?  @map("tax_id")
  currency       String   @default("ETB") @db.Char(3)
  defaultTaxBps  Int      @default(0) @map("default_tax_bps")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("issuer_profiles")
  @@schema("invoice")
}

model Invoice {
  id              String        @id @default(cuid())
  status          InvoiceStatus @default(draft)
  invoiceNumber   String?       @unique @map("invoice_number")
  issueDate       DateTime      @map("issue_date") @db.Date
  currency        String        @db.Char(3)
  taxRateBps      Int           @map("tax_rate_bps")

  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  billingAddress  String?       @map("billing_address")
  notes           String?

  subtotalMinor   BigInt        @map("subtotal_minor")
  taxMinor        BigInt        @map("tax_minor")
  totalMinor      BigInt        @map("total_minor")

  version         Int           @default(1)
  submittedAt     DateTime?     @map("submitted_at")
  snapshot        Json?

  lineItems       LineItem[]

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("invoices")
  @@schema("invoice")
}

model LineItem {
  id              String   @id @default(cuid())
  invoiceId       String   @map("invoice_id")
  position        Int
  description     String
  quantityMilli   Int      @map("quantity_milli")
  unitPriceMinor  BigInt   @map("unit_price_minor")
  lineTotalMinor  BigInt   @map("line_total_minor")

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("line_items")
  @@schema("invoice")
}

/// Allocates sequential invoice numbers per calendar year on submit.
model InvoiceNumberSequence {
  year      Int @id
  lastValue Int @map("last_value")

  @@map("invoice_number_sequences")
  @@schema("invoice")
}
