# Copy to .env and fill in. Never commit real secrets.

DATABASE_URL="postgresql://invoice:invoice@localhost:5432/invoice_creation?schema=invoice"

# Optional gate for internal use. If set, every /api/* request must send:
#   Authorization: Bearer <INTERNAL_APP_TOKEN>
INTERNAL_APP_TOKEN=""

# ISO 4217. Minor-unit scale is derived from this (ETB/USD = 2).
DEFAULT_CURRENCY="ETB"

# Tax in basis points. 1500 = 15.00%. 0 = no tax until a rate is approved.
DEFAULT_TAX_BPS="0"

NEXT_PUBLIC_APP_NAME="Invoice Creation"
