DATABASE_URL="postgresql://invoice:invoice@localhost:5432/invoice?schema=public"

# Seller identity snapshotted onto every invoice. Set real values in the n8n/devops workflow.
COMPANY_NAME="BitBirr"
COMPANY_ADDRESS=""
COMPANY_EMAIL=""
COMPANY_VAT=""

# Approved product defaults (Ethiopian VAT).
CURRENCY=ETB
TAX_RATE_BPS=1500

# Required login. Do not commit real secrets. n8n/devops injects production values.
AUTH_EMAIL="invoices@example.com"
AUTH_PASSWORD="change-me"
AUTH_SECRET="change-me-to-a-long-random-string"
