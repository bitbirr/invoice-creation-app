# PostgreSQL (see docker-compose.yml)
DATABASE_URL="postgresql://invoice:invoice@localhost:5432/invoice_creation"

# Issuer printed on invoices and PDFs
ISSUER_NAME="BitBirr Technology Solutions"
ISSUER_ADDRESS=""
ISSUER_EMAIL=""
ISSUER_PHONE=""

# ISO 4217. MVP assumes a 2-decimal currency.
DEFAULT_CURRENCY="ETB"

# 1500 = 15.00% (Ethiopia VAT). Override per invoice in the form.
DEFAULT_TAX_RATE_BPS="1500"
